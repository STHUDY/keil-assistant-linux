{
    "name": "keil-assistant-linux",
    "displayName": "Keil Assistant For Linux",
    "description": "An assistant for Keil uVision (Forked and maintained)",
    "version": "2.0.0",
    "publisher": "sthudy",
    "author": {
        "name": "STHUDY"
    },
    "keywords": [
        "keil",
        "arm",
        "c51",
        "c251",
        "8051",
        "stm32",
        "arm"
    ],
    "homepage": "https://github.com/STHUDY/keil-assistant-linux",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Other"
    ],
    "icon": "res/icons/icon.png",
    "main": "./dist/src/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/STHUDY/keil-assistant-linux"
    },
    "bugs": {
        "url": "https://github.com/STHUDY/keil-assistant-linux/issues"
    },
    "contributes": {
        "configuration": [
            {
                "title": "Keil Assistant Linux",
                "properties": {
                    "KeilAssistantLinux.Wine.Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "%keil.wine.path.description%",
                        "default": "wine"
                    },
                    "KeilAssistantLinux.Wine.PrefixPath": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "%keil.wine.prefix.description%",
                        "default": ""
                    },
                    "KeilAssistantLinux.C51.Uv4Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "%keil.c51.uv4path.description%",
                        "default": ""
                    },
                    "KeilAssistantLinux.C251.Uv4Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "%keil.c251.uv4path.description%",
                        "default": ""
                    },
                    "KeilAssistantLinux.ARM.Uv4Path": {
                        "type": "string",
                        "scope": "machine",
                        "markdownDescription": "%keil.arm.uv4path.description%",
                        "default": ""
                    },
                    "KeilAssistantLinux.Base.AutoReplacePath": {
                        "type": "boolean",
                        "scope": "machine",
                        "markdownDescription": "%keil.base.auto-replace-path.description%",
                        "default": true
                    },
                    "KeilAssistantLinux.Project.FileLocationList": {
                        "type": "array",
                        "scope": "resource",
                        "markdownDescription": "%keil.project.locations.description%",
                        "default": []
                    },
                    "KeilAssistantLinux.Project.ExcludeList": {
                        "type": "array",
                        "scope": "resource",
                        "markdownDescription": "%keil.project.exclude.description%",
                        "default": [
                            "template.uvproj",
                            "template.uvprojx"
                        ]
                    },
                    "KeilAssistantLinux.flash.device": {
                        "type": "string",
                        "scope": "resource",
                        "markdownDescription": "%keil.flash.device.description%",
                        "enum": [
                            "KEIL5 MDK",
                            "ST-LINK V2",
                            "CMSIS DAP Link"
                        ],
                        "default": "ST-LINK V2"
                    },
                    "KeilAssistantLinux.flash.st-flashPath": {
                        "type": "string",
                        "scope": "resource",
                        "markdownDescription": "%keil.flash.st-flashPath.description%",
                        "default": "st-flash"
                    },
                    "KeilAssistantLinux.flash.openocdPath": {
                        "type": "string",
                        "scope": "resource",
                        "markdownDescription": "%keil.flash.openocdPath.description%",
                        "default": "openocd"
                    },
                    "KeilAssistantLinux.flash.openocdTargetCfgMap": {
                        "type": "object",
                        "scope": "resource",
                        "markdownDescription": "%keil.flash.openocdTargetCfgMap.description%",
                        "default": {
                            "STM32F0*": "target/stm32f0x.cfg",
                            "STM32F1*": "target/stm32f1x.cfg",
                            "STM32F2*": "target/stm32f2x.cfg",
                            "STM32F3*": "target/stm32f3x.cfg",
                            "STM32F4*": "target/stm32f4x.cfg",
                            "STM32F7*": "target/stm32f7x.cfg",
                            "STM32G0*": "target/stm32g0x.cfg",
                            "STM32G4*": "target/stm32g4x.cfg",
                            "STM32H7*": "target/stm32h7x.cfg",
                            "STM32L0*": "target/stm32l0.cfg",
                            "STM32L1*": "target/stm32l1.cfg",
                            "STM32L4*": "target/stm32l4x.cfg",
                            "STM32L5*": "target/stm32l5x.cfg",
                            "STM32U5*": "target/stm32u5x.cfg",
                            "STM32WB*": "target/stm32wbx.cfg",
                            "STM32WL*": "target/stm32wlx.cfg",
                            "STM32MP1*": "target/stm32mp15x.cfg",
                            "STM32W108*": "target/stm32w108xx.cfg",
                            "STM32XL*": "target/stm32xl.cfg",
                            "GD32VF103*": "target/gd32vf103.cfg",
                            "GD32E23*": "target/gd32e23x.cfg",
                            "RP2040*": "target/rp2040.cfg",
                            "NRF51*": "target/nrf51.cfg",
                            "NRF52*": "target/nrf52.cfg",
                            "LPC11*": "target/lpc11xx.cfg",
                            "LPC12*": "target/lpc12xx.cfg",
                            "LPC13*": "target/lpc13xx.cfg",
                            "LPC17*": "target/lpc17xx.cfg",
                            "LPC18*": "target/lpc1850.cfg",
                            "LPC2*": "target/lpc2xxx.cfg",
                            "LPC29*": "target/lpc2900.cfg",
                            "LPC31*": "target/lpc3131.cfg",
                            "LPC32*": "target/lpc3250.cfg",
                            "LPC40*": "target/lpc40xx.cfg",
                            "LPC43*": "target/lpc4350.cfg",
                            "LPC54*": "target/lpc54xxx.cfg",
                            "LPC8*": "target/lpc8xx.cfg",
                            "LPC84*": "target/lpc84x.cfg",
                            "STM8L*": "target/stm8l.cfg",
                            "STM8S*": "target/stm8s.cfg",
                            "ATSAM3*": "target/at91sam3XXX.cfg",
                            "ATSAM4*": "target/at91sam4XXX.cfg",
                            "ATSAMD*": "target/at91samdXX.cfg",
                            "ATSAME*": "target/atsame5x.cfg",
                            "ATSAML*": "target/atsaml1x.cfg",
                            "ATSAMV*": "target/atsamv.cfg",
                            "CC13*": "target/ti_cc13x0.cfg",
                            "CC26*": "target/ti_cc26x0.cfg",
                            "MSP432*": "target/ti_msp432.cfg",
                            "ESP32S2*": "target/esp32s2.cfg",
                            "ESP32S3*": "target/esp32s3.cfg",
                            "ESP32*": "target/esp32.cfg",
                            "MKE*": "target/ke0x.cfg",
                            "MKL*": "target/klx.cfg",
                            "EFM32*": "target/efm32.cfg",
                            "PSOC4*": "target/psoc4.cfg",
                            "PSOC5*": "target/psoc5lp.cfg",
                            "PSOC6*": "target/psoc6.cfg",
                            "XMC1*": "target/xmc1xxx.cfg",
                            "XMC4*": "target/xmc4xxx.cfg",
                            "BLUENRG*": "target/bluenrg-x.cfg",
                            "MAX32620*": "target/max32620.cfg",
                            "MAX32625*": "target/max32625.cfg",
                            "MAX3263*": "target/max3263x.cfg",
                            "CC2538*": "target/cc2538.cfg",
                            "NUMICRO*": "target/numicro.cfg",
                            "SWM050*": "target/swm050.cfg"
                        },
                        "additionalProperties": {
                            "type": "string"
                        }
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "explorer.open",
                "title": "Open keil uVision project",
                "icon": {
                    "light": "./res/icons/ClassAdded_16x.svg",
                    "dark": "./res/icons/ClassAdded_16x.svg"
                }
            },
            {
                "command": "project.switch",
                "title": "Switch Target",
                "icon": {
                    "light": "./res/icons/SwitchSourceOrTarget_16x.svg",
                    "dark": "./res/icons/SwitchSourceOrTarget_16x.svg"
                }
            },
            {
                "command": "project.active",
                "title": "Active Project"
            },
            {
                "command": "project.close",
                "title": "Close Project",
                "icon": {
                    "light": "./res/icons/StatusOffline_16x.svg",
                    "dark": "./res/icons/StatusOffline_16x.svg"
                }
            },
            {
                "command": "project.build",
                "title": "Build",
                "icon": {
                    "light": "./res/icons/BuildSelection_16x.svg",
                    "dark": "./res/icons/BuildSelection_16x.svg"
                }
            },
            {
                "command": "project.flash",
                "title": "Flash",
                "icon": {
                    "light": "./res/icons/TransferDownload_16x.svg",
                    "dark": "./res/icons/TransferDownload_16x.svg"
                }
            },
            {
                "command": "project.rebuild",
                "title": "Rebuild",
                "icon": {
                    "light": "./res/icons/BuildSolution_16x.svg",
                    "dark": "./res/icons/BuildSolution_16x.svg"
                }
            },
            {
                "command": "item.copyValue",
                "title": "Copy Item Value",
                "icon": {
                    "light": "./res/icons/CopyToClipboard_16x.svg",
                    "dark": "./res/icons/CopyToClipboard_16x.svg"
                }
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "explorer.open",
                    "group": "navigation",
                    "when": "view == project"
                }
            ],
            "view/item/context": [
                {
                    "command": "project.close",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.active",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.switch",
                    "group": "inline",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.build",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.flash",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.rebuild",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "item.copyValue",
                    "group": "inline",
                    "when": "viewItem == Source"
                }
            ]
        },
        "keybindings": [
            {
                "command": "project.build",
                "key": "f7"
            },
            {
                "command": "project.flash",
                "key": "ctrl+alt+d"
            },
            {
                "command": "project.rebuild",
                "key": "ctrl+alt+f7"
            }
        ],
        "snippets": [
            {
                "language": "a51",
                "path": "./syntaxes/a51.snippets.json"
            }
        ],
        "languages": [
            {
                "id": "a51",
                "aliases": [
                    "A51",
                    "8051 Assembly"
                ],
                "extensions": [
                    ".a51",
                    ".A51"
                ],
                "filenamePatterns": [
                    "**/*.a51",
                    "**/*.A51"
                ],
                "configuration": "./syntaxes/a51.language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "a51",
                "scopeName": "source.asm.a51",
                "path": "./syntaxes/a51.tmLanguage.json"
            }
        ],
        "views": {
            "explorer": [
                {
                    "icon": "",
                    "id": "project",
                    "name": "Keil uVision Project"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "keil-task"
            }
        ],
        "problemMatchers": [
            {
                "name": "c51",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning):\\s+(#\\d+):\\s+(.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                ]
            },
            {
                "name": "armcc",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning):\\s+#([\\d\\w-]+):\\s+(.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                ]
            },
            {
                "name": "gcc",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^(.+):(\\d+):(\\d+):\\s+(\\w+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile && webpack --mode production",
        "publish": "vsce package",
        "compile": "npx tsc -p ./",
        "watch": "npx tsc -watch -p ./",
        "webpack": "npx webpack --mode development",
        "webpack:watch": "npx webpack --mode development --watch",
        "lint": "npx eslint src --ext .ts",
        "pretest": "npm run lint && npm run compile",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^7.1.1",
        "@types/mocha": "^10.0.1",
        "@types/node": "^18.19.86",
        "@types/vscode": "^1.85.0",
        "@types/xml2js": "^0.4.14",
        "@typescript-eslint/eslint-plugin": "^5.54.0",
        "@typescript-eslint/parser": "^5.54.0",
        "eslint": "^8.35.0",
        "glob": "^7.1.5",
        "mocha": "^10.2.0",
        "ts-loader": "^9.4.2",
        "typescript": "^4.9.5",
        "vscode-test": "^1.6.1",
        "webpack": "^5.75.0",
        "webpack-cli": "^5.0.1"
    },
    "dependencies": {
        "@vscode/vsce": "^4.0.0",
        "xml2js": "^0.6.2"
    }
}
